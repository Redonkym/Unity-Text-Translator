  <!-- Публикуем .NET 8 single-file и добавляем как EmbeddedResource до CreateManifestResourceNames. -->
  <!-- Скачивает msdf-atlas-gen (win64) при первой сборке и встраивает exe в манифест (как AddressablesCatalogCrcZero). -->
  <Target Name="EnsureMsdfAtlasGenEmbedded">
    <PropertyGroup>
      <MsdfToolDirNoSlash>$(ProjectDir)Tools\msdf-atlas-gen</MsdfToolDirNoSlash>
      <MsdfExe>$(MsdfToolDirNoSlash)\msdf-atlas-gen.exe</MsdfExe>
    </PropertyGroup>
    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Scripts\EnsureMsdfAtlasGen.ps1&quot; -OutDir &quot;$(MsdfToolDirNoSlash)&quot;"
      Condition="!Exists('$(MsdfExe)')"
      IgnoreExitCode="true"
      ContinueOnError="true" />
    <Warning Condition="!Exists('$(MsdfExe)')" Text="msdf-atlas-gen.exe не скачан (нет сети или сбой). Повторите сборку онлайн или положите exe в Tools\msdf-atlas-gen\ — иначе кнопка TTF→TMP не запустит генератор." />
    <ItemGroup Condition="Exists('$(MsdfExe)')">
      <EmbeddedResource Include="$(MsdfExe)">
        <LogicalName>msdf-atlas-gen.exe</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
